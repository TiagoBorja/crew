#!/bin/sh
# crew - run wrapper for crew agents.
#
#   crew run <agent> "<task>" [--tier fast|standard|deep] [--engine codex|claude] [--cwd DIR] [--dry-run]
#   crew list | doctor | version | help
#
# POSIX sh + awk. CREW_HOME overrides ~/.crew (mainly for tests).
# Exit codes of "run": 0 PASS (gates also need VERDICT: PASS), 1 FAIL or
# VERDICT: FAIL, 2 usage, 3 BLOCKED, 4 no valid STATUS line (or a gate without
# a VERDICT line), 127 engine not installed.
set -eu

CREW_HOME=${CREW_HOME:-${HOME:-}/.crew}
CFG=$CREW_HOME/config

usage() {
    cat <<'EOF'
Usage:
  crew run <agent> "<task>" [--tier fast|standard|deep] [--engine codex|claude] [--cwd DIR] [--dry-run]
  crew list      agents with tier, gate and description
  crew doctor    installed files vs manifest, tools on PATH, versions
  crew version
  crew help

"crew run <agent> -" reads a full HANDOFF block from stdin instead of a one-line task.
--tier (or a "tier:" line in the HANDOFF) runs the agent on another tier than its
default. Gate agents can be raised but never lowered.
Agents are looked up in ./.crew/agents (or --cwd) first, then ~/.crew/agents.
EOF
}

die() {
    code=$1
    shift
    echo "crew: $*" >&2
    exit "$code"
}

TMP=
cleanup() { if [ -n "$TMP" ]; then rm -rf "$TMP"; fi; }
trap cleanup EXIT
trap 'exit 1' INT TERM HUP
mktmp() {
    if [ -z "$TMP" ]; then TMP=$(mktemp -d "${TMPDIR:-/tmp}/crew.XXXXXX"); fi
}

# ---- helpers ----------------------------------------------------------------

fm_get() { # file key
    awk -v k="$2" '
        NR == 1 && $0 == "---" { fm = 1; next }
        fm && $0 == "---" { exit }
        fm { i = index($0, ":")
             if (i && substr($0, 1, i - 1) == k) {
                 v = substr($0, i + 1); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v); print v; exit } }' "$1"
}

cfg_get() { # key default
    if [ -f "$CFG" ]; then
        awk -v k="$1" -v d="$2" '
            /^[ \t]*#/ { next }
            { i = index($0, "="); if (!i) next
              key = substr($0, 1, i - 1); gsub(/[ \t]/, "", key)
              if (key != k) next
              v = substr($0, i + 1); sub(/[ \t]+#.*$/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v)
              val = v; found = 1 }
            END { if (found && val != "") print val; else print d }' "$CFG"
    else
        printf '%s\n' "$2"
    fi
}

map_tools() { # capabilities reads_only separator
    awk -v caps="$1" -v ro="$2" -v sep="$3" '
        BEGIN { gsub(/[\[\],]/, " ", caps); n = split(caps, c, " "); for (i = 1; i <= n; i++) has[c[i]] = 1
                split("read:Read search:Grep search:Glob edit:Edit edit:Write shell:Bash web:WebFetch web:WebSearch", m, " ")
                for (i = 1; i <= 8; i++) {
                    split(m[i], kv, ":")
                    if (!(kv[1] in has) || (kv[2] in seen)) continue
                    if (ro == "true" && (kv[2] == "Edit" || kv[2] == "Write")) continue
                    seen[kv[2]] = 1; out = out (out == "" ? "" : sep) kv[2] }
                print out }'
}

script_dir() { # resolves symlinks so bin/crew can be linked onto PATH
    sd_f=$0
    while [ -L "$sd_f" ]; do
        sd_l=$(readlink "$sd_f")
        case $sd_l in
            /*) sd_f=$sd_l ;;
            *) sd_f=$(dirname "$sd_f")/$sd_l ;;
        esac
    done
    (cd "$(dirname "$sd_f")" && pwd)
}

source_version() {
    sv_dir=$(script_dir)
    if [ -f "$sv_dir/../VERSION" ]; then
        head -n 1 "$sv_dir/../VERSION" | tr -d ' \r'
    fi
}

sha_of() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum < "$1"; else shasum -a 256 < "$1"; fi | awk '{ print $1 }'
}

valid_name() {
    case $1 in
        "" | -* | *- | *[!a-z0-9-]* | *--*) return 1 ;;
    esac
    return 0
}

# ---- run --------------------------------------------------------------------

resolve_agent() { # name cwd -> path or empty
    if [ -f "$2/.crew/agents/$1.md" ]; then
        printf '%s\n' "$2/.crew/agents/$1.md"
    elif [ -f "$CREW_HOME/agents/$1.md" ]; then
        printf '%s\n' "$CREW_HOME/agents/$1.md"
    fi
}

handoff_block() { # agent task
    if [ "$2" = - ]; then
        cat "$TMP/stdin"
        return 0
    fi
    printf 'HANDOFF\nto: %s\nobjective: %s\ninputs:\n  - none\nconstraints:\n  - none\nexpected_output:\n  - none\n' "$1" "$2"
}

status_exit() { # out-file gate -> prints exit code
    se=$(awk '
        { sub(/\r$/, "") }
        /^STATUS: (PASS|FAIL|BLOCKED)[ \t]*$/ { st = $2 }
        /^VERDICT: (PASS|FAIL)[ \t]*$/ { vd = $2 }
        END { print st "," vd }' "$1")
    st=${se%,*}
    vd=${se#*,}
    case $st in
        BLOCKED) echo 3 ;;
        FAIL) echo 1 ;;
        PASS)
            if [ "$2" != true ]; then
                echo 0
            elif [ "$vd" = PASS ]; then
                echo 0
            elif [ "$vd" = FAIL ]; then
                echo 1
            else
                echo 4
            fi
            ;;
        *) echo 4 ;;
    esac
}

cmd_run() {
    r_agent=
    r_task=
    r_engine=
    r_cwd=
    r_dry=0
    r_have_task=0
    r_want_tier=
    while [ $# -gt 0 ]; do
        case $1 in
            --engine)
                [ $# -gt 1 ] || die 2 "--engine needs a value"
                r_engine=$2
                shift
                ;;
            --tier)
                [ $# -gt 1 ] || die 2 "--tier needs a value"
                r_want_tier=$2
                shift
                ;;
            --cwd)
                [ $# -gt 1 ] || die 2 "--cwd needs a value"
                r_cwd=$2
                shift
                ;;
            --dry-run) r_dry=1 ;;
            --help | -h)
                usage
                exit 0
                ;;
            -) r_task=-; r_have_task=1 ;;
            -*) die 2 "unknown option: $1" ;;
            *)
                if [ -z "$r_agent" ]; then
                    r_agent=$1
                elif [ "$r_have_task" = 0 ]; then
                    r_task=$1
                    r_have_task=1
                else
                    die 2 "unexpected argument: $1 (quote the task)"
                fi
                ;;
        esac
        shift
    done
    [ -n "$r_agent" ] || die 2 "usage: crew run <agent> \"<task>\" [--tier fast|standard|deep] [--engine codex|claude] [--cwd DIR] [--dry-run]"
    valid_name "$r_agent" || die 2 "invalid agent name: $r_agent"
    [ "$r_have_task" = 1 ] && [ -n "$r_task" ] || die 2 "missing task (use - to read a HANDOFF from stdin)"
    [ -n "$r_engine" ] || r_engine=$(cfg_get RUN_ENGINE codex)
    case $r_engine in codex | claude) ;; *) die 2 "invalid engine '$r_engine' (codex or claude)" ;; esac
    if [ -z "$r_cwd" ]; then r_cwd=$(pwd); fi
    [ -d "$r_cwd" ] || die 2 "--cwd is not a directory: $r_cwd"
    r_cwd=$(cd "$r_cwd" && pwd)
    r_file=$(resolve_agent "$r_agent" "$r_cwd")
    [ -n "$r_file" ] || die 2 "agent not found: $r_agent (looked in $r_cwd/.crew/agents and $CREW_HOME/agents)"

    r_tier=$(fm_get "$r_file" tier)
    r_gate=$(fm_get "$r_file" gate)
    r_ro=$(fm_get "$r_file" reads_only)
    r_caps=$(fm_get "$r_file" capabilities)
    case $r_tier in fast | standard | deep) ;; *) die 2 "agent $r_agent has no valid tier in $r_file" ;; esac

    mktmp
    if [ "$r_task" = - ]; then
        cat > "$TMP/stdin"
        if [ -z "$r_want_tier" ]; then
            r_want_tier=$(awk '{ sub(/\r$/, "") } /^tier:[ \t]*/ { sub(/^tier:[ \t]*/, ""); sub(/[ \t]+$/, ""); print; exit }' "$TMP/stdin")
        fi
    fi
    r_default_tier=$r_tier
    if [ -n "$r_want_tier" ]; then
        case $r_want_tier in fast | standard | deep) ;; *) die 2 "invalid tier '$r_want_tier' (fast, standard or deep)" ;; esac
        if [ "$r_gate" = true ] && [ "$(tier_rank "$r_want_tier")" -lt "$(tier_rank "$r_tier")" ]; then
            die 2 "gate agent $r_agent cannot run below its tier ($r_tier)"
        fi
        r_tier=$r_want_tier
    fi
    r_guard=$CREW_HOME/guardrails.md
    if [ ! -f "$r_guard" ]; then
        echo "crew: warning: $r_guard not found; run install.sh first" >&2
        r_guard=/dev/null
    fi
    handoff_block "$r_agent" "$r_task" > "$TMP/handoff"
    { cat "$r_guard"; printf '\n'; cat "$r_file"; } > "$TMP/system"
    { cat "$TMP/system"; printf '\n'; cat "$TMP/handoff"; } > "$TMP/prompt"

    if [ "$r_engine" = codex ]; then
        run_codex
    else
        run_claude
    fi
}

tier_rank() {
    case $1 in fast) echo 1 ;; standard) echo 2 ;; *) echo 3 ;; esac
}

dry_header() {
    printf 'engine: %s\nagent: %s\ntier: %s\ndefault_tier: %s\ngate: %s\nreads_only: %s\ncwd: %s\n' \
        "$r_engine" "$r_file" "$r_tier" "$r_default_tier" "$r_gate" "$r_ro" "$r_cwd"
}

run_codex() {
    set -- codex exec --profile "crew-$r_tier"
    if [ "$r_ro" = true ]; then set -- "$@" --sandbox read-only; fi
    set -- "$@" -
    if [ "$r_dry" = 1 ]; then
        dry_header
        echo "command: $*"
        echo "--- prompt (stdin) ---"
        cat "$TMP/prompt"
        exit 0
    fi
    command -v codex >/dev/null 2>&1 || die 127 "engine not found on PATH: codex"
    set +e
    { (cd "$r_cwd" && "$@" < "$TMP/prompt"); echo "$?" > "$TMP/rc"; } | tee "$TMP/out"
    set -e
    finish
}

run_claude() {
    case $r_tier in
        fast) r_model=$(cfg_get CLAUDE_MODEL_FAST haiku) ;;
        standard) r_model=$(cfg_get CLAUDE_MODEL_STANDARD sonnet) ;;
        *) r_model=$(cfg_get CLAUDE_MODEL_DEEP opus) ;;
    esac
    r_omit=0
    case $r_caps in *mcp*) if [ "$r_ro" != true ]; then r_omit=1; fi ;; esac
    r_tools=
    if [ "$r_omit" = 0 ]; then r_tools=$(map_tools "$r_caps" "$r_ro" ,); fi
    if [ "$r_dry" = 1 ]; then
        dry_header
        printf 'model: %s\n' "$r_model"
        if [ "$r_omit" = 1 ]; then echo "tools: (inherited, mcp)"; else echo "tools: $r_tools"; fi
        printf 'command: claude -p --model %s' "$r_model"
        if [ "$r_omit" = 0 ]; then printf ' --allowedTools "%s"' "$r_tools"; fi
        echo ' --append-system-prompt <system prompt> <handoff>'
        echo "--- system prompt ---"
        cat "$TMP/system"
        echo "--- handoff ---"
        cat "$TMP/handoff"
        exit 0
    fi
    command -v claude >/dev/null 2>&1 || die 127 "engine not found on PATH: claude"
    set -- claude -p --model "$r_model"
    if [ "$r_omit" = 0 ]; then set -- "$@" --allowedTools "$r_tools"; fi
    set -- "$@" --append-system-prompt "$(cat "$TMP/system")" "$(cat "$TMP/handoff")"
    set +e
    { (cd "$r_cwd" && "$@" < /dev/null); echo "$?" > "$TMP/rc"; } | tee "$TMP/out"
    set -e
    finish
}

finish() {
    fi_rc=$(cat "$TMP/rc")
    if [ "$fi_rc" != 0 ]; then echo "crew: warning: engine exited with status $fi_rc" >&2; fi
    exit "$(status_exit "$TMP/out" "$r_gate")"
}

# ---- list -------------------------------------------------------------------

cmd_list() {
    mktmp
    : > "$TMP/names"
    for d in "$(pwd)/.crew/agents" "$CREW_HOME/agents"; do
        for f in "$d"/*.md; do
            if [ -f "$f" ]; then
                b=${f##*/}
                printf '%s\n' "${b%.md}" >> "$TMP/names"
            fi
        done
    done
    if [ ! -s "$TMP/names" ]; then
        echo "crew: no agents installed (run install.sh)" >&2
        return 0
    fi
    printf '%-26s %-9s %-5s %s\n' agent tier gate description
    LC_ALL=C sort -u "$TMP/names" > "$TMP/sorted"
    while IFS= read -r n; do
        f=$(resolve_agent "$n" "$(pwd)")
        printf '%-26s %-9s %-5s %s\n' "$n" "$(fm_get "$f" tier)" "$(fm_get "$f" gate)" "$(fm_get "$f" description)"
    done < "$TMP/sorted"
}

# ---- doctor -----------------------------------------------------------------

doctor_entries() { # manifest -> path TAB sha TAB kind
    awk '
        function fld(l, k,   i, r) { i = index(l, "\"" k "\":\""); if (!i) return ""; r = substr(l, i + length(k) + 4); return substr(r, 1, index(r, "\"") - 1) }
        /^\{"path":/ { printf "%s\t%s\t%s\n", fld($0, "path"), fld($0, "sha256"), fld($0, "kind") }' "$1"
}

block_inner() { # file begin end
    awk -v b="$2" -v e="$3" '
        $0 == e && inb { exit }
        inb { print }
        $0 == b { inb = 1 }' "$1"
}

entry_sha() { # path kind
    case $2 in
        block)
            case $1 in
                *.toml) block_inner "$1" '# crew:begin' '# crew:end' > "$TMP/inner" ;;
                *) block_inner "$1" '<!-- crew:begin -->' '<!-- crew:end -->' > "$TMP/inner" ;;
            esac
            sha_of "$TMP/inner"
            ;;
        *) sha_of "$1" ;;
    esac
}

cmd_doctor() {
    mktmp
    bad=0
    n_ok=0
    if [ ! -d "$CREW_HOME" ]; then
        echo "FAIL crew home not found: $CREW_HOME (run install.sh)"
        exit 1
    fi
    echo "ok   crew home: $CREW_HOME"
    iv=
    if [ -f "$CREW_HOME/VERSION" ]; then iv=$(head -n 1 "$CREW_HOME/VERSION" | tr -d ' \r'); fi
    sv=$(source_version)
    echo "ok   installed version: ${iv:-unknown}; source version: ${sv:-unknown}"
    if [ -n "$iv" ] && [ -n "$sv" ] && [ "$iv" != "$sv" ]; then
        echo "warn installed version differs from source: run ./install.sh --update"
    fi
    if [ ! -f "$CREW_HOME/manifest.json" ]; then
        echo "FAIL manifest missing: $CREW_HOME/manifest.json"
        bad=1
    else
        doctor_entries "$CREW_HOME/manifest.json" > "$TMP/entries"
        tab=$(printf '\t')
        while IFS="$tab" read -r p s k; do
            if [ ! -e "$p" ] && [ ! -L "$p" ]; then
                echo "FAIL missing: $p"
                bad=1
            elif [ "$(entry_sha "$p" "$k")" != "$s" ]; then
                echo "FAIL drift (edited or source changed): $p"
                bad=1
            else
                n_ok=$((n_ok + 1))
            fi
        done < "$TMP/entries"
        echo "ok   $n_ok manifest entries match"
    fi
    for t in awk codex claude; do
        if command -v "$t" >/dev/null 2>&1; then
            echo "ok   $t on PATH"
        elif [ "$t" = awk ]; then
            echo "FAIL awk not on PATH"
            bad=1
        else
            echo "info $t not on PATH (optional)"
        fi
    done
    if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; then
        echo "ok   sha-256 tool available"
    else
        echo "FAIL no sha256sum or shasum"
        bad=1
    fi
    if [ -f "$(pwd)/.crew/context.md" ]; then echo "ok   project context: .crew/context.md"; else echo "info no .crew/context.md in $(pwd)"; fi
    exit "$bad"
}

# ---- dispatch ---------------------------------------------------------------

if [ $# -eq 0 ]; then
    usage >&2
    exit 2
fi
cmd=$1
shift
case $cmd in
    run) cmd_run "$@" ;;
    list) cmd_list ;;
    doctor) cmd_doctor ;;
    version | --version)
        v=$(source_version)
        if [ -z "$v" ] && [ -f "$CREW_HOME/VERSION" ]; then v=$(head -n 1 "$CREW_HOME/VERSION" | tr -d ' \r'); fi
        echo "crew ${v:-unknown}"
        ;;
    help | --help | -h) usage ;;
    *)
        echo "crew: unknown command: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac
